{
  "name": "hidden-pictures",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^24.12.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run assets:check && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:rules": "node scripts/run-qa.mjs rules",
    "test:assets": "vitest run tests/assets",
    "test:e2e": "node scripts/run-qa.mjs e2e",
    "assets:check": "tsx scripts/check-assets.ts",
    "rules:generate": "tsx scripts/generate-database-rules.ts",
    "emulators": "firebase emulators:start --only auth,database --project demo-hidden-pictures",
    "deploy:rules": "bash scripts/deploy-rules.sh",
    "qa": "node scripts/run-qa.mjs all"
  },
  "dependencies": {
    "firebase": "13.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "firebase-tools": "^15.34.2",
    "globals": "^15.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
