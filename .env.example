# Public Firebase web config (safe for the browser). Never put service account keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional:
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_STORAGE_BUCKET=

# Local development against Auth + RTDB emulators:
# VITE_USE_EMULATORS=1

# GitHub Pages project site base path, e.g. /hidden-pictures/
# VITE_BASE_PATH=/hidden-pictures/
